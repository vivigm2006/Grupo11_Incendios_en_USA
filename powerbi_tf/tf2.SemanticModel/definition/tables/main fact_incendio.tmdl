	column dias_contencion
		dataType: int64
		formatString: 0
		lineageTag: dbafe467-4986-454a-8e09-67813c94e8f4
		summarizeBy: none
		sourceColumn: dias_contencion

		annotation SummarizationSetBy = User

	column 'Rango Dias Contencion' =
			
			SWITCH(
			    TRUE(),
			    'main fact_incendio'[dias_contencion] >= 1 && 'main fact_incendio'[dias_contencion] <= 50, "1. De 1 a 50 días",
			    'main fact_incendio'[dias_contencion] > 50 && 'main fact_incendio'[dias_contencion] <= 150, "2. De 51 a 150 días",
			    'main fact_incendio'[dias_contencion] > 150 && 'main fact_incendio'[dias_contencion] <= 500, "3. De 151 a 500 días",
			    'main fact_incendio'[dias_contencion] > 500, "4. Más de 500 días",
			    "Sin días / Mismo día"
			)
		lineageTag: 88b0773a-60c6-4c0e-8ea7-60a02c1982f2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column region_name = RELATED ( 'main dim_region'[region_name] )
