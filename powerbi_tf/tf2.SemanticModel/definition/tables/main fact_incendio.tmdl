table 'main fact_incendio'
	lineageTag: ac2e303e-421a-464c-bb4b-8e838efd4b8f

	measure 'Incendios por Clase Real' =
			
			CALCULATE(
			    COUNTROWS('main fact_incendio'),
			    VALUES('main fact_incendio'[clase])
			)
		formatString: 0
		lineageTag: a797f02d-c889-46cd-bca7-75cf65b1d3b7

	measure 'Promedio Dias Contencion Real' =
			
			CALCULATE(
			    AVERAGE('main fact_incendio'[dias_contencion]),
			    'main fact_incendio'[dias_contencion] > 0
			)
		lineageTag: 960ebbf8-e4fb-4e64-9352-b0c86480623d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Estados por Region' =
			
			DISTINCTCOUNT ( 'main fact_incendio'[state_name] )
		formatString: 0
		lineageTag: 0730767d-95b8-4530-aaa6-73fbd5c2cfd6

